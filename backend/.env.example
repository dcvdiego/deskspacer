# Server Configuration
SERVER_PORT=5221

# Database Configuration
# For local development with PostgreSQL:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deskspacer
DB_USER=postgres
DB_PASSWORD=12345678
DB_SSLMODE=disable

# For Neon.tech (production):
# DB_HOST=your-project.neon.tech
# DB_PORT=5432
# DB_NAME=deskspacer
# DB_USER=your-username
# DB_PASSWORD=your-password
# DB_SSLMODE=require

# CORS Configuration (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost,https://studio.apollographql.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=20
RATE_LIMIT_AUTH_PER_15MIN=5
RATE_LIMIT_PASSWORD_PER_1HOUR=3

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h

# Email Configuration (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com
FRONTEND_URL=http://localhost:5173

# Cloudflare R2 Configuration
# Get these from Cloudflare Dashboard -> R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=deskspacer-glbs
R2_PUBLIC_URL=https://your-bucket.your-account.r2.cloudflarestorage.com

# Stripe Configuration
# Get these from https://stripe.com/dashboard
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_price_id
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancel

# Feature Limits
STATE_LIMIT_FREE=5
STATE_LIMIT_PREMIUM=100
GLB_LIMIT_PREMIUM=10
GLB_SIZE_LIMIT=5242880
GLB_TOTAL_STORAGE_LIMIT=52428800

# State Expiration (for anonymous states)
STATE_EXPIRATION_DAYS=15
CLEANUP_INTERVAL_HOURS=24
